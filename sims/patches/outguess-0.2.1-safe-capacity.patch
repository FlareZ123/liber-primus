diff --git a/iterator.c b/iterator.c
index 1111111..2222222 100644
--- a/iterator.c
+++ b/iterator.c
@@ -31,3 +31,5 @@
 #include <sys/types.h>
+#include <stdio.h>
+#include <stdlib.h>
 
 #include "config.h"
@@ -72,6 +74,22 @@
 void
 iterator_adapt(iterator *iter, bitmap *bitmap, int datalen)
 {
-	iter->skipmod = SKIPADJ(bitmap->bits, bitmap->bits - iter->off) *
-		(bitmap->bits - iter->off)/(8 * datalen);
+	int remaining;
+	int next_skip;
+
+	if (datalen <= 0 || bitmap->bits < 32 ||
+	    iter->off < 0 || iter->off > bitmap->bits) {
+		fprintf(stderr, "Invalid iterator capacity state: offset=%d bits=%d datalen=%d\n",
+			iter->off, bitmap->bits, datalen);
+		exit(1);
+	}
+	remaining = bitmap->bits - iter->off;
+	next_skip = (int)(SKIPADJ(bitmap->bits, remaining) *
+		remaining / (8 * datalen));
+	if (next_skip < 1) {
+		fprintf(stderr, "Insufficient remaining iterator capacity: %d bits for %d bytes\n",
+			remaining, datalen);
+		exit(1);
+	}
+	iter->skipmod = (u_int32_t)next_skip;
 }
