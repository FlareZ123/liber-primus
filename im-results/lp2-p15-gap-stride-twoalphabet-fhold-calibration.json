  "branch": " if(originJob?.customSchedule){const {K,C,control,seed=0x44f15,rank=1,phase=0}=originJob;let rows=C,truth=null,A=null,B=null;\n if(control!==undefined){const rand=random(seed^0xabc123),donors=[gp(shakespeare),gp(gibran)];truth=[donors[control].slice(30000,30000+K.length)];A=perm(rand,true);B=perm(rand,false);rows=[encrypt(truth[0],K,A,B)];}\n const result=curriculum(rows,K,seed,truth,A,B);return {rank,phase,control:control??null,visibleF:rows.map(x=>x.filter(y=>y===0).length),literalF:truth?.map(x=>x.filter(y=>y===0).length)??null,result};}\n"
